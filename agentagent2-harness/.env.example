# Copy to .env and fill in, or export these directly. Not loaded automatically (no
# python-dotenv dependency, by design — see README "Why zero dependencies"); source it
# yourself, e.g. `set -a && source .env && set +a`, or pass values via your process
# manager / container orchestrator.

# Required unless every invocation uses --mock / mock=True.
ANTHROPIC_API_KEY=

# Optional overrides — all have sane built-in defaults (see agentagent2/config.py).
# AGENTAGENT2_MODEL=claude-sonnet-4-20250514
# AGENTAGENT2_BASE_URL=https://api.anthropic.com
# AGENTAGENT2_MAX_TOKENS=4096
# AGENTAGENT2_MAX_STEPS=24
# AGENTAGENT2_TEMPERATURE=0.2
# AGENTAGENT2_WORKSPACE=.
# AGENTAGENT2_MOCK=false
