# Copy to .env and fill. NEVER commit the real .env (git-ignored).
# Secrets are referenced by name in config/mcp.servers.json and injected at runtime.

# Model provider
ANTHROPIC_API_KEY=

# Optional MCP servers (leave blank to keep disabled)
GITHUB_TOKEN=
DATABASE_URL=

# Set by the devcontainer; bounds filesystem MCP server
WORKSPACE_DIR=
